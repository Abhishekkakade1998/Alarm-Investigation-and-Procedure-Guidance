FROM python:3.11-slim

WORKDIR /app

COPY apps/backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY apps/backend/copilot.py .
COPY rag/ rag/

EXPOSE 8001

CMD ["sh", "-c", "python -m rag.ingestion.ingester && exec python -m uvicorn copilot:app --host 0.0.0.0 --port 8001"]
