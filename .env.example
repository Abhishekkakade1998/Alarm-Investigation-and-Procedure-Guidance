# Alarm Management API Simulator
ALARM_API_BASE_URL=http://alarm-simulator:8000
ALARM_API_TOKEN=demo-token

# MCP Server
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=9000
MCP_SERVER_URL=http://alarm-mcp:9000

# Copilot Backend
COPILOT_HOST=0.0.0.0
COPILOT_PORT=8001
COPILOT_LOG_LEVEL=INFO

# Local LLM (Ollama)
# Host Ollama URL for Docker Compose; use localhost when running backend directly
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_GPU=0
OLLAMA_NUM_PREDICT=512
MAX_MCP_TOOL_ROUNDS=3

# RAG and Vector Store
VECTOR_STORE_PATH=./rag/qdrant_data
DOCUMENT_PATH=./rag/documents
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Environment
ENVIRONMENT=development
DEBUG=false
